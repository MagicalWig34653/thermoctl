# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Umgebung / Secrets
.env
.env.*
!.env.example

# Lokale Daten (SQLite-Standardbetrieb)
*.db
*.sqlite
*.sqlite3
data/

# Logs
logs/
*.log

# Test / Linting
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Werkzeuge
.idea/
# Portnummer wechselt mit jedem Start der IDE — rein oertlich.
.mcp.json
.vscode/
.DS_Store

# iCloud-Konfliktdubletten ("Datei 2.py") -- nie Teil des Projekts
*\ 2.*

# .venv liegt als .venv.nosync daneben, .venv ist ein Symlink darauf -- iCloud
# ueberspringt alles, was auf .nosync endet. Siehe docs/self-hosting.md.
.venv.nosync
