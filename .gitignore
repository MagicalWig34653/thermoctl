# Python
__pycache__/
*.py[cod]
# Ohne Schraegstrich: .venv ist hier ein *Symlink* auf .venv.tmp, also eine Datei.
# Mit ".venv/" allein war er nicht erfasst und wurde versehentlich eingecheckt.
.venv
.venv/
venv/
*.egg-info/
build/
dist/

# Umgebung / Secrets
.env
.env.*
!.env.example

# Lokale Daten (SQLite-Standardbetrieb)
*.db
*.sqlite
*.sqlite3
data/

# Logs
logs/
*.log

# Test / Linting
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Werkzeuge
.idea/
# Portnummer wechselt mit jedem Start der IDE — rein oertlich.
.mcp.json
.vscode/
.DS_Store

# iCloud-Konfliktdubletten ("Datei 2.py") -- nie Teil des Projekts
# Erfasst beide Formen, die iCloud erzeugt: "deviation 2.py" mit Endung und
# ".coverage 2" ohne. Das Muster stand hier zuerst nur mit Punkt -- 28 Dubletten
# ohne Endung sind dadurch eingecheckt worden, darunter neunzehn .coverage und
# sogar ein Abbild des .venv-Symlinks.
*\ [0-9]*

# .venv liegt als .venv.tmp daneben, .venv ist ein Symlink darauf. Der oft genannte
# .nosync-Trick wirkt nur auf Dateien, nicht auf Ordner: In .venv.nosync lagen
# weiterhin iCloud-Konfliktkopien. Fuer Ordner ist .tmp die Entsprechung.
.venv.tmp

# Zwischenspeicher des Code-Review-Werkzeugs, 6,5 MB
.code-review-graph/
