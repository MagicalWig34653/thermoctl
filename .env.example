# Pflichtangaben. Ohne sie startet der Dienst nicht.
# Verbindungszeichenfolge, z. B. sqlite:///./data/thermoctl.db
#                          oder mysql+pymysql://benutzer:passwort@host:3306/thermoctl
THERMOCTL_DATABASE_URL=
# Zufälliger Schlüssel, mindestens 32 Zeichen. Erzeugen: python -c "import secrets; print(secrets.token_urlsafe(48))"
THERMOCTL_SECRET_KEY=

# Optional. Leer gelassen gilt jeweils der als Kommentar genannte Vorgabewert.
THERMOCTL_BIND_HOST=          # Vorgabe: 0.0.0.0
THERMOCTL_BIND_PORT=          # Vorgabe: 8000
THERMOCTL_LOG_LEVEL=          # Vorgabe: INFO
THERMOCTL_LOG_FORMAT=         # Vorgabe: json
# Nur einschalten, wenn der Dienst hinter TLS läuft
THERMOCTL_SECURE_COOKIES=     # Vorgabe: false

# --- MQTT (Zigbee2MQTT) ---------------------------------------------------------
# MQTT ist insgesamt optional. Sobald es eingeschaltet wird, liest thermoctl nicht nur
# Sensoren: Es nimmt ueber den Broker auch Befehle fuer alle Zonen entgegen. Deshalb sind
# ein eigener Broker-Zugang mit Benutzername, Passwort und eng begrenzten Rechten
# Betriebsanforderung; die genaue Rechtematrix steht in docs/mqtt.md. Der Dienst erzwingt
# diese Broker-Konfiguration nicht selbst.
THERMOCTL_MQTT_ENABLED=       # Vorgabe: false — bewusst aus, bis der Broker eingetragen ist
THERMOCTL_MQTT_HOST=          # z. B. 192.168.0.10
THERMOCTL_MQTT_PORT=          # Vorgabe: 1883, mit TLS ueblicherweise 8883
THERMOCTL_MQTT_TLS=           # Vorgabe: false
THERMOCTL_MQTT_CA_CERT=       # Pfad zum CA-Zertifikat, nur bei eigener CA noetig
THERMOCTL_MQTT_USERNAME=      # bei aktiviertem MQTT erforderlich; eigener Zugang fuer thermoctl
THERMOCTL_MQTT_PASSWORD=      # nur in .env einsetzen, nie in Repository oder Beispiel
THERMOCTL_MQTT_CLIENT_ID=     # Vorgabe: thermoctl
THERMOCTL_MQTT_BASE_TOPIC=    # Vorgabe: zigbee2mqtt

# Der eigene Teilbaum: Hier veroeffentlicht thermoctl seinen Zustand, hoert auf Befehle
# und meldet die Zonen bei Home Assistant an. Getrennt von BASE_TOPIC, das Zigbee2MQTT
# gehoert -- zwei Schreiber in einem Teilbaum sind der zuverlaessigste Weg zu einem
# Fehler, den niemand mehr zuordnen kann.
THERMOCTL_MQTT_PREFIX=       # Vorgabe: thermoctl

# --- Meross (Steckdosen, die als Ventile dienen) ---------------------------------
# Ohne diese Angaben meldet sich der Adapter als 'nicht konfiguriert' und tut nichts.
# In Teilprojekt 2 ist das der Normalfall — es wird ohnehin nichts geschaltet.
THERMOCTL_MEROSS_EMAIL=
THERMOCTL_MEROSS_PASSWORD=
THERMOCTL_MEROSS_API_BASE=    # Vorgabe: https://iotx-eu.meross.com (regionsabhaengig)

# --- Benachrichtigungen bei Stoerungen -------------------------------------------
# Gemeldet wird der Wechsel in eine Stoerung und die Entwarnung, nicht der Zustand —
# eine Meldung je Regelzyklus waere nach einer Nacht unbenutzbar.
# Ins Log geht sie immer; ein Webhook nur, wenn hier eine Adresse steht.
THERMOCTL_NOTIFY_WEBHOOK=          # z. B. https://…/hooks/heizung
THERMOCTL_NOTIFY_WEBHOOK_TOKEN=    # optional, geht als Authorization: Bearer mit

# --- MCP-Server ------------------------------------------------------------------
# Nur noetig, wenn der MCP-Server benutzt wird (optionale Abhaengigkeit, siehe docs/mcp.md).
# Ohne dieses Token startet er nicht — einen Modus ohne Anmeldung gibt es nicht.
THERMOCTL_MCP_TOKEN=

# --- Passkeys (WebAuthn) ---------------------------------------------------------
# Ohne THERMOCTL_PASSKEY_RP_ID sind Passkeys abgeschaltet — nicht halb, sondern ganz.
# Die Relying-Party-ID ist der nackte Hostname ohne Schema und ohne Port. Sie steht
# ausschliesslich hier und wird nie aus der Anfrage gebildet: Die `Host`-Kopfzeile setzt
# der Aufrufer, und eine Relying-Party-ID unter seiner Kontrolle hebt den Schutz auf.
THERMOCTL_PASSKEY_RP_ID=        # z. B. heizung.example.org
THERMOCTL_PASSKEY_RP_NAME=      # Vorgabe: thermoctl (Name im Anmeldedialog)
# Leer gelassen gilt https://<RP_ID>. WebAuthn laesst http ausschliesslich auf
# localhost zu — fuer die Entwicklung also http://localhost:8000.
THERMOCTL_PASSKEY_ORIGIN=
